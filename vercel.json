{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build",
  "outputDirectory": "public",
  "functions": {
    "api/mcp.js": { "maxDuration": 300 }
  },
  "rewrites": [
    { "source": "/mcp", "destination": "/api/mcp" },
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/oauth-protected-resource" },
    { "source": "/.well-known/oauth-protected-resource/mcp", "destination": "/api/oauth-protected-resource" }
  ],
  "redirects": [
    { "source": "/", "destination": "https://docs.capydb.dev/docs/guides/integrations/claude", "permanent": false }
  ]
}
